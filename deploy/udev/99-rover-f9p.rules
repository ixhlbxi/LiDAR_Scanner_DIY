# Stable /dev/rover-f9p symlink for the rover's ZED-F9P RTK GNSS receiver.
# Mirrors the sibling Base-Station's 99-rtk-f9p.rules — same vid:pid (u-blox
# 1546:01a9), different symlink name so a Pi can host both repos' devices
# without collision.
#
# After install:
#   sudo cp deploy/udev/99-rover-f9p.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   ls -la /dev/rover-f9p

SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", \
    SYMLINK+="rover-f9p", MODE="0660", GROUP="dialout"
